/*
	Updates to DMKR_TRANSLAT table for Documaker Translations
*/
DECLARE
	v_seq NUMBER;
BEGIN
	SELECT max(DISPLAYSEQ) INTO v_seq FROM DMKR_TRANSLAT WHERE GROUP_ID='BCHINGS.BCHINGARCDEST';
	v_seq := v_seq + 1;
	INSERT INTO DMKR_TRANSLAT (SYS_ID, AL_ID, APP_ID, LOCALE_ID, GROUP_ID, ID, DISPLAY, DESCRIPTION, DISPLAYSEQ) VALUES
	(1, 1, 0, 'en', 'BCHINGS.BCHINGARCDEST', 'OBP_Post', 'OBP_Post', 'OBP Post Destination', v_seq);
	COMMIT;
	
	SELECT max(DISPLAYSEQ) INTO v_seq FROM DMKR_TRANSLAT WHERE GROUP_ID='BCHINGS.BCHINGARCDEST';
	v_seq := v_seq + 1;
	INSERT INTO DMKR_TRANSLAT (SYS_ID, AL_ID, APP_ID, LOCALE_ID, GROUP_ID, ID, DISPLAY, DESCRIPTION, DISPLAYSEQ) VALUES
	(1, 1, 0, 'en', 'BCHINGS.BCHINGARCDEST', 'OBP_Email', 'OBP_Email', 'OBP Email Destination', v_seq);
	COMMIT;
	
	SELECT max(DISPLAYSEQ) INTO v_seq FROM DMKR_TRANSLAT WHERE GROUP_ID='BCHINGS.BCHINGSGNDEST';
	v_seq := v_seq + 1;
	INSERT INTO DMKR_TRANSLAT (SYS_ID, AL_ID, APP_ID, LOCALE_ID, GROUP_ID, ID, DISPLAY, DESCRIPTION, DISPLAYSEQ) VALUES
	(1, 1, 0, 'en', 'BCHINGS.BCHINGSGNDEST', 'OBP_Archive', 'OBP_Archive', 'OBP IPM Archive Destination', v_seq);
	COMMIT;
	
	UPDATE DMKR_TRANSLAT SET DISPLAY='Dispatch-Delivery', DESCRIPTION='Batchings Archive Destination Label'  WHERE GROUP_ID = 'BCHINGS.BCHINGARCLBL' AND ID='Archive' and DISPLAY='Archive';
	
	UPDATE DMKR_TRANSLAT SET DISPLAY='Archive-Generation', DESCRIPTION='Batchings Sign Destination Label'  WHERE GROUP_ID = 'BCHINGS.BCHINGSGNLBL' AND ID='Sign' and DISPLAY='Sign';
	COMMIT;
END;
