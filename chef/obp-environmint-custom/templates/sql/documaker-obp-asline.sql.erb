/*
	*** This file MUST only be run once per new Documaker Build **

	Author: Romil Bhagat
	Last Updated: 30-09-2016
	This file configures Oracle Documaker with OBP
	This is a direct modification of the Application Contexts that you can alternatively do using the Documaker Administrator GUI
	This file is for Documakmer 12.3.0 and 12.4.0
	This file must be run as DMKR_ASLINE User


*/

/* Block for configuring BCHINGS table for properties */
DECLARE
	/* Variable Definitions */
BEGIN
	UPDATE BCHINGS SET BCHINGACTIVE=0, 
	BCHINGSELECTRULE='''RCPS.RCBRCPNAME=''Customer_Email'' OR RCPS.RCBRCPNAME=''Bank_Email'' OR RCPS.RCBRCPNAME=''Guarantor_Email''', 
	BCHINGPRTTYPE='PDF', BCHINGARCDEST='OBP_Email', BCHINGSGNDEST='OBP_Archive', BCHINGMIMETYPE='application/pdf',
	BCHINGARCHIVE=1, BCHINGSIGNING=1, BCHINGPUBLISH=0
	WHERE BCHINGNAME='EMAIL' AND BATCHNAME='BATCH1' AND BATCHTYPE='ADDRESSEE';

	UPDATE BCHINGS SET BCHINGACTIVE=1, 
	BCHINGSELECTRULE='RCPS.RCBRCPNAME=''Customer'' OR RCPS.RCBRCPNAME=''Bank'' OR RCPS.RCBRCPNAME=''Guarantor''', 
	BCHINGPRTTYPE='PDF', BCHINGARCDEST='OBP_Post', BCHINGSGNDEST='OBP_Archive', BCHINGMIMETYPE='application/pdf',
	BCHINGARCHIVE=1, BCHINGSIGNING=1, BCHINGPUBLISH=0
	WHERE BCHINGNAME='LOCALPRINT' AND BATCHNAME='BATCH1' AND BATCHTYPE='ADDRESSEE';

	UPDATE BCHINGS SET BCHINGACTIVE=0
	WHERE BCHINGNAME='BATCH' AND BATCHNAME='BATCH1' AND BATCHTYPE='ADDRESSEE';

	UPDATE BCHINGS SET BCHINGACTIVE=0
	WHERE BCHINGNAME='MMS' AND BATCHNAME='BATCH1' AND BATCHTYPE='ADDRESSEE';

	UPDATE BCHINGS SET BCHINGACTIVE=0
	WHERE BCHINGNAME='SMS' AND BATCHNAME='BATCH1' AND BATCHTYPE='ADDRESSEE';

	COMMIT;
END;
/

