                    "permTarget": "resourceType=oracle.bi.publisher.permission,resourceName=oracle.bi.publisher.runReportOnline",
                    "permActions": "_all_"
                }
            },
            {
            "name": "WeblogicPolicyPermission_5",
            "type": "WeblogicPolicyPermission",
            "attributes": {
                "appStripe": "obi",
                "principalClass": "oracle.security.jps.service.policystore.ApplicationRole",
                "principalName": "BIServiceAdministrator",
                "permClass": "oracle.security.jps.ResourcePermission",
                "permTarget": "resourceType=oracle.bi.publisher.permission,resourceName=oracle.bi.publisher.developDataModel",
                "permActions": "_all_"
            }
            },
            {
