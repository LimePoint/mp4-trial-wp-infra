                    "1": "-Xms<%= @obpbip["bi_server"]['ms_heap'] %> -Xmx<%= @obpbip["bi_server"]['mx_heap'] %>",
                    "2": "-XX:NewSize=256m -XX:MaxNewSize=1024m ",
                    "3": "-Dserver.group=obi -Dweblogic.MuxerClass=weblogic.socket.PosixSocketMuxer",
                    "4": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappdynamics.agent.tierName=OBP-BIP -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obpbip['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
                    "5": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
                    <%= render "common-startup-params.erb",
                        :variables => {
                            :log_location_path => log_location_path,
                            :certs_location_path => certs_location_path,
                            :truststore => @common['trustStore']
