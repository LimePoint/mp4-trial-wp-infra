                            <%= render "common-run-wlst.erb",
							   :variables => {
								   :name => "deletedefaultMachine",
								   :host_identifier => @obpbip['hostnameList'][0],
								   :wlst_command => "#{fmw_install_path}/oracle_common/common/bin/wlst.sh",
								   :script => "#{@common['custom_source']}/common/deleteWeblogicMachine.py",
								   :t3_connect_url => "t3://#{@obpbip['admin']['listen_address']}#{@obpbip['dns_domain_name']}:#{@obpbip['admin']['listen_port']}",
								   :admin_username => @obpbip['wls_admin_user'],
								   :admin_password => PasswordVault.get_password(password_vault_name, asset_code, @obpbip['wls_admin_user']),
								   :args => "#{@obpbip['admin']['listen_address']}",
								   :when => 'post-configure'
							   }
						   %>
                           ,
                            {
                                "name": "clobberOBIEESingletonFolder",
                                "hostIdentifierList": [
                                    "<%= @obpbip['hostnameList'][0] %>"
                                ],
                                "sourceFile": "rm -rf <%= obiee_singleton_folder %>",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-clobber"
                                ]
                            },
                            {
                                "name": "CreateBIPDatasource",
                                "hostIdentifierList": [
                                    "<%= @obpbip['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::obpbip-create-datasource]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "pre-online"
                                ]
                            },
                            {
                                "name": "CreateDatabaseObjects",
                                "hostIdentifierList": [
                                    "<%= @obpbip['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::create-db-users]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-rcu"
                                ]
                            },
                            {
                                "name": "DeleteDatabaseObjects",
                                "hostIdentifierList": [
                                    "<%= @obpbip['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::drop-db-users]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-clobber"
                                ]
                            },
                            {
                                "name": "FMW-App-Role-Mapping",
                                "hostIdentifierList": [
                                    "<%= @obpbip['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::fmw-app-role-mapping]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-online"
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "databaseList": [
            {
                "name": "<%= environment_name %><%= asset_code %>db",
                "port": "<%= @obpbip['database']['listen_port'] %>",
                "serviceName": "<%= @obpbip['database']['service_name'] %>",
                "properties": [
                    {
                        "name": "rcu.datafile.initialsize",
                        "value": "200M",
                        "target": "rcu.datafile.initialsize"
                    },
                    {
                        "target": "rcu.extra.parameters",
                        "value": " -encryptTablespace <%= @obpbip['database'].key?('encryption') ? @obpbip['database']['encryption'] : 'false' %>"
                    },
                    {
                        "name": "jdbcUrl",
                        "value": "jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(Host=${_.host.address})(Port=${_.port}))(CONNECT_DATA=(SERVER = DEDICATED)(SERVICE_NAME=${_.serviceName})))"
                    }
                ],
                "hostIdentifier": "db_server",
                "schemaList": [
                  {
                    "name": "<%= @obpbip['database']['sysdba_username'].upcase %>",
                    "password": "<%= PasswordVault.get_password(password_vault_name, asset_code, @obpbip['database']['sysdba_username'].upcase) %>"
                  }
                ]
            }
        ],
        "resourceList": [

            <%= render "common-settings-resources.erb",
                :variables => {
                    :environment_name => environment_name,
                    :password_vault_name => password_vault_name,
                    :asset_code => asset_code,
                    :domain_name => @obpbip['wls_domain_name'],
                    :log_location_path => log_location_path,
                    :certs_location_path => certs_location_path,
                    :admin_kestore_alias => @obpbip['hostnameList'][0],
                    :managed_keystore_alias => '%ListenAddress/noprefix%',
                    :keystore_name => @obpbip['hostnameList'][0][0...-2],
                    :common => @common,
                    :frontend => @obpbip['frontend'],
                    :database => @obpbip['database'],
                    :set_dual_site_url => @obpbip['database'].key?('set_dual_site_url') ? @obpbip['database']['set_dual_site_url'].downcase : "false",
                    :enable_dbssl => "false"
                }
            %>
            ,
            <%= render "common-oid-authenticator.erb",
                :variables => {
                    :name => 'OIDAuthenticator',
                    :hostname => @obpoid['frontend']['managed_host'],
                    :port => @obpoid['frontend']['ldap_port'],
                    :username => 'cn=obpbip_readonly,cn=serviceaccounts,cn=users,dc=westpac,dc=com,dc=au',
                    :password => PasswordVault.get_password(password_vault_name, 'obpoid', 'obpbip_readonly'),
                    :group_base_dn => 'ou=obiee,ou=apps,dc=westpac,dc=com,dc=au',
                    :user_base_dn => 'cn=users,dc=westpac,dc=com,dc=au',
                    :common => @common
                }
            %>
