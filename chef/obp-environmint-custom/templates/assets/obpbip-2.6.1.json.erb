                "permClass": "oracle.security.jps.ResourcePermission",
                "permTarget": "resourceType=oracle.bi.publisher.permission,resourceName=oracle.bi.publisher.developReport",
                "permActions": "_all_"
                }
            },
            {
                "name": "WeblogicPolicyPermission_3",
                "type": "WeblogicPolicyPermission",
                "attributes": {
                    "appStripe": "obi",
                    "principalClass": "oracle.security.jps.service.policystore.ApplicationRole",
