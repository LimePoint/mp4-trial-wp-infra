                    :username => 'cn=obpsoa_readonly,cn=serviceaccounts,cn=users,dc=westpac,dc=com,dc=au',
                    :password => PasswordVault.get_password(password_vault_name, 'obpoid', 'obpsoa_readonly'),
                    :group_base_dn => 'ou=apps,dc=westpac,dc=com,dc=au',
                    :user_base_dn => 'cn=users,dc=westpac,dc=com,dc=au',
                    :common => @common
                }
            %>
            ,
            <%= render "common-oid-authenticator.erb",
                :variables => {
                    :name => 'CIDAuthenticator',
                    :hostname => @obpcid['frontend']['managed_host'],
                    :port => @obpcid['frontend']['ldap_port'],
                    :username => 'cn=obpsoa_readonly,cn=serviceaccounts,cn=users,dc=westpac,dc=com,dc=au',
                    :password => PasswordVault.get_password(password_vault_name, 'obpcid', 'obpsoa_readonly'),
                    :group_base_dn => 'cn=customer,cn=groups,dc=westpac,dc=com,dc=au',
                    :user_base_dn => 'cn=customer,cn=users,dc=westpac,dc=com,dc=au',
