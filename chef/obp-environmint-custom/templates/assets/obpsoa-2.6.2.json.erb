						"3": "-Dweblogic.MuxerClass=weblogic.socket.PosixSocketMuxer -Doracle.jdbc.autoCommitSpecCompliant=false -Djps.combiner.optimize.lazyeval=TRUE -Djps.combiner.optimize=TRUE -Djps.policystore.hybrid.mode=false -Djps.authz=ACC",
						"4": "-Dweblogic.configuration.schemaValidationEnabled=false -Duser.home=<%= fmw_install_path %>/obpinstall/obp/config",
						"5": "-Dfacade.security.check=false -Dcom.sun.jndi.ldap.connect.pool.protocol=ssl -Dcom.sun.jndi.ldap.connect.pool=true -Dcom.sun.jndi.ldap.connect.pool.initsize=10 -Dcom.sun.jndi.ldap.connect.pool.prefsize=20",
						"6": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappdynamics.agent.tierName=OBP-SOA -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obpsoa['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
						"7": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
						<%= render "obp-startup-params.erb",
						:variables => {
							:log_location_path => log_location_path,
							:certs_location_path => certs_location_path,
							:truststore => @common['trustStore']
						}
						%>
				}
            },
            {
                "name": "HTClusterStartupParameters",
                "type": "StartupParameter",
                "attributes": {
                    "1": "-Xms<%= @obpsoa['obphumantask_server']['ms_heap'] %> -Xmx<%= @obpsoa['obphumantask_server']['mx_heap'] %>",
                    "2": "-XX:+UseG1GC -XX:MaxGCPauseMillis=200  -XX:SurvivorRatio=8 -XX:MaxTenuringThreshold=15 -XX:ParallelGCThreads=8 -XX:ConcGCThreads=4 -XX:G1HeapRegionSize=8M",
                    "3": "-Dweblogic.MuxerClass=weblogic.socket.PosixSocketMuxer -Doracle.jdbc.autoCommitSpecCompliant=false -Djps.combiner.optimize.lazyeval=TRUE -Djps.combiner.optimize=TRUE -Djps.policystore.hybrid.mode=false -Djps.authz=ACC",
                    "4": "-Dweblogic.configuration.schemaValidationEnabled=false -Duser.home=<%= fmw_install_path %>/obpinstall/obp/config",
                    "5": "-Dfacade.security.check=false -Dobp.http.staleCheckEnabled=true -Dweblogic.servlet.DIDisabled=true -Dobp.http.idleTimeoutPollInterval=5000 -Dobp.http.maxRetryCount=3 -Dobp.http.socketBufferSize=8192 -Dobp.http.expireAndRetry=true -Djbo.ampool.doampooling=false -Dobp.http.connectionTimeout=600000 -Dobp.http.maxConnectionsPerHost=150 -Djavax.xml.parsers.DocumentBuilderFactory=com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl -Djavax.xml.transform.TransformerFactory=com.sun.org.apache.xalan.internal.xsltc.trax.TransformerFactoryImpl -Djavax.xml.parsers.SAXParserFactory=com.sun.org.apache.xerces.internal.jaxp.SAXParserFactoryImpl",
                    "6": "-DOriginationUIPropertiesConstant:enableEnrichmentLink=false -DSecurityConstants:isUIComponentSecurityCallLocal=false -Dcom.sun.jndi.ldap.connect.pool.protocol=ssl -Dcom.sun.jndi.ldap.connect.pool=true -Dcom.sun.jndi.ldap.connect.pool.initsize=10 -Dcom.sun.jndi.ldap.connect.pool.prefsize=20 -DAdapterFactories:UI_SECURITY_ADPT_MOCKED=false -DSecurityConstants:BLACKOUT.RELOAD.INTERVAL=86400000",
                    "7": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappdynamics.agent.tierName=OBP-SOA-HT -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obpsoa['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
					"8": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
                    <%= render "obp-startup-params.erb",
                            :variables => {
                            :log_location_path => log_location_path,
                            :certs_location_path => certs_location_path,
                            :truststore => @common['trustStore']
                        }
                    %>
                }
            },
            {
                "name": "BAMClusterStartupParameters",
                "type": "StartupParameter",
                "attributes": {
                    "1": "-Xms<%= @obpsoa['bam_server']['ms_heap'] %> -Xmx<%= @obpsoa['bam_server']['mx_heap'] %>",
                    "2": "-XX:NewSize=512m -XX:MaxNewSize=2048m -Dweblogic.MuxerClass=weblogic.socket.PosixSocketMuxer -Doracle.jdbc.autoCommitSpecCompliant=false",
                    "7": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappdynamics.agent.tierName=OBP-SOA-BAM -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obpsoa['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
                    "8": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
                    <%= render "common-startup-params.erb",
