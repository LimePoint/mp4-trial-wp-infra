<% environment_name = @environment['name'] %>
<% password_vault_name = @common['password_vault_name'] %>
<% dns_domain = @obpotd["dns_domain_name"] ; if dns_domain.nil? then dns_domain=".mintpress.io" end %>
<% asset_code = @code.downcase  %>
<% uniquifier = @uuid.tr('-', '') %>

<% base_install_path = '/oracle/app/binaries/' + asset_code  %>
<% base_domain_path  = '/oracle/app/runtime/' + asset_code + '/domains' %>
<% otd_instance_top  = '/oracle/app/instances/' + asset_code + '/domains' %>

<% log_location_path   = '/oracle/app/logs/' + asset_code %>
<% certs_location_path = '/oracle/app/runtime/' + environment_name + '/certs' %>

<% java_install_path      = base_install_path + '/java' %>
<% jdk_version            = '8' %>

<% fmw_install_path           = base_install_path + '/fmw' %>
<% inventory_install_path = base_install_path + '/oraInventory' %>
<% temp_location          = base_install_path + '/tmp' %>
<% otd_temp_location      = '/oracle/app/otdtmp' %>
<% otd_admin_server_top   = base_domain_path %>
<% node_manager_top       = fmw_install_path + '/wlserver/common/nodemanager' %>

{
    "internalVariables":
    {
        "environmentName": "<%= environment_name %>",
        "assetCode": "<%= asset_code %>",
        "stageRootDir": "/oracle/stage"
    },
    "projectName": "<%= environment_name %>_<%= asset_code %>_<%= uniquifier %>",
    "uniquifier": "<%= uniquifier %>",
    "site": {
        "hostList": [
            {
                "id": "<%= @obpotd['hostnameList'][0] %>",
                "address": "${_.basename}<%= @obpotd['dns_domain_name'] %>",
                "properties": [
                    {
                        "name": "basename",
                        "value": "<%= @obpotd['hostnameList'][0] %>"
                    }
                ],
                "groupRefs":
                [
                    "Common_Host_Details",
                    "List_Of_TVT_Tests"
                ]
            }
        ],
        "installationList": [

            {
                "name": "jdk",
                "product": "jdk",
                "version": "1.8.0_221",
                "installPath": "<%= java_install_path %>",
                "softwareStage": "${stageRootDir}/jdk/jdk-8u221-linux-x64.tar.gz",
                "groupRefs":
                [
                    "Common_Installation_Details"
                ]
            },
            {
                "name": "fmwinfra",
                "product": "fmwinfra",
                "version": "12.2.1.3",
                "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/fmw_12.2.1.3.0_infrastructure.jar",
                "installPath": "<%= fmw_install_path %>",
                "groupRefs":
                [
                    "Common_Installation_Details"
                ],
                "dependsonList": [
                    "jdk"
                ],
                "patchset": [
                  {
                    "targetOracleHome": "${_.installPath}",
                    "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
                    "name": "29921455",
                    "aru": "29921455",
                    "properties": [
                        {
                          "name": "action",
                          "value": "rollback"
                        }
                      ]
                  },
                  {
                    "targetOracleHome": "${_.installPath}",
                    "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
                    "name": "29814665",
                    "aru": "29814665",
                    "properties": [
                        {
                          "target": "opatch.minimum.version",
                          "value": "13.9.4.2"
                        },
                        {
                          "target": "opatch.binary.location",
                          "value": "${stageRootDir}/common_patches/OPatch/139420/6880880"
                        },
                        {
                          "target": "opatch.update.usegeneric",
                          "value": "true"
                        },
                        {
                          "name": "patchWhen",
                          "value": "post-binaries"
                        }
                      ]
                  }
                ]
            },
            {
                "name": "otd",
                "product": "otd",
                "version": "12.2.1.3",
                "installPath": "<%= fmw_install_path %>/otd",
                "softwareStage": "${stageRootDir}/otd/12.2.1.3/fmw_12.2.1.3.0_otd_linux64.bin",
                "groupRefs":
                [
                    "Common_Installation_Details"
                ],
                "dependsonList": [
                    "fmwinfra"
                ]
            }
        ],
        "environmentList": [
            {
                "name": "<%= environment_name %>",
                "webgateInstanceList": [
                    {
                        "name": "MultiSSO",
                        <% if @obpotd['alter_site_oam_url'] %>
                        "url": "http://<%= @obpotd['alter_site_oam_url'] %>",
                        <% else %>
                        "url": "http://<%= @obpoam['admin']['listen_address'] %><%= @obpoam['dns_domain_name'] %>:<%= @obpoam['admin']['listen_port'] %>",
                        <% end %>
                        "username": "<%= @obpoam['wls_admin_user'] %>",
                        "password": "<%= PasswordVault.get_password(password_vault_name, 'obpoam', @obpoam['wls_admin_user'] ) %>",
                        "rregHome": "${stageRootDir}/iam/11.1.2.3/Disk2/stage/Components/oracle.oam.server/11.1.2.3.0/1/DataFiles/Expanded/server/rreg/client/RREG.tar.gz",
                        "runOnTarget": "true"
                    }
                ],
                "mwTopologyList": [
                    {
                        "name": "<%= asset_code %>",
                        "description": "<%= environment_name %> <%= asset_code %> Environment",
                        "nodeManagerList": [
                            {
                                "name": "nm-<%= @obpotd['hostnameList'][0] %>",
                                "listenAddress": "<%= @obpotd['nm']['listen_address'] %><%= @obpotd['dns_domain_name'] %>",
                                "listenPort": "<%= @obpotd['nm']['listen_port'] %>",
                                "hostIdentifier": "<%= @obpotd['hostnameList'][0] %>",
                                "groupRefs": [
                                    "Node_Manager_Common_Config",
                                    "Node_Manager_SSL_Config"
                                ],
                                "properties": [
                                    {
                                        "target": "wls.nodemanager.log.path",
                                        "value": "<%= log_location_path %>/${/host.basename}"
                                    },
                                    {
                                        "value": "${/host.basename}",
                                        "target": "wls.nodemanager.identityname"
                                    },
                                    {
                                        "value": "<%= certs_location_path %>/<%= @obpotd['hostnameList'][0][0...-2] %>.jks",
                                        "target": "wls.nodemanager.identitystorefile"
                                    }
