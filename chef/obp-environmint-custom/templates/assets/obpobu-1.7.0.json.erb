                    "6": "-Dfacade.security.check=false -DOriginationUIPropertiesConstant:enableEnrichmentLink=false -Dcom.sun.jndi.ldap.connect.pool.protocol=ssl -Dcom.sun.jndi.ldap.connect.pool=true -Dcom.sun.jndi.ldap.connect.pool.initsize=10 -Dcom.sun.jndi.ldap.connect.pool.prefsize=20 -DSecurityConstants:BLACKOUT.RELOAD.INTERVAL=86400000",
                    "7": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappagent.install.dir=/oracle/app/binaries/appdynamics/javaagent -Dappdynamics.agent.tierName=OBP-UI -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obpobu['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
					"8": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
                    "9": "-Dfile.encoding=UTF-8",
                    <%= render "obp-startup-params.erb",
