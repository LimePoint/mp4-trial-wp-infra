<% environment_name = @environment['name'] %>
<% password_vault_name = @common['password_vault_name'] %>
<% dns_domain = @obpobu["dns_domain_name"] ; if dns_domain.nil? then dns_domain=".mintpress.io" end %>
<% asset_code = @code.downcase  %>
<% uniquifier = @uuid.tr('-', '') %>

<% base_install_path = '/oracle/app/binaries/' + asset_code  %>
<% base_domain_path  = '/oracle/app/runtime/' + asset_code + '/domains' %>

<% log_location_path   = '/oracle/app/logs/' + asset_code %>
<% certs_location_path = '/oracle/app/runtime/' + environment_name + '/certs' %>

<% oracle_install_path      = base_install_path + '/dbclient' %>
<% java_install_path      = base_install_path + '/java' %>
<% jdk_version            = '8' %>

<% fmw_install_path           = base_install_path + '/fmw' %>
<% inventory_install_path = base_install_path + '/oraInventory' %>
<% temp_location          = '/oracle/app/binaries/tmp' %>

<% obu_admin_server_top   = base_domain_path %>
<% obu_managed_server_top = obu_admin_server_top %>
<% node_manager_top       = fmw_install_path + '/wlserver/common/nodemanager' %>

{
    "internalVariables":
    {
        "environmentName": "<%= environment_name %>",
        "assetCode": "<%= asset_code %>",
        "stageRootDir": "/oracle/stage"
    },
    "projectName": "<%= environment_name %>_<%= asset_code %>_<%= uniquifier %>",
    "uniquifier": "<%= uniquifier %>",
    "site": {
        "hostList": [
            {
                "id": "<%= @obpobu['hostnameList'][0] %>",
                "address": "${_.basename}<%= @obpobu['dns_domain_name'] %>",
                "properties": [
                    {
                        "name": "basename",
                        "value": "<%= @obpobu['hostnameList'][0] %>"
                    }
                ],
                "groupRefs":
                [
                    "Common_Host_Details",
                    "List_Of_TVT_Tests"
                ]
            },
            {
            <% if @obpobu['alter_site_reassociate_hostname'] %> 
                "id": "<%= @obpobu['alter_site_reassociate_hostname'] %>",
                "address": "<%= @obpobu['alter_site_reassociate_hostname'] %>",
                "properties": [
                    {
                        "name": "basename",
                        "value": "<%= @obpobu['alter_site_reassociate_hostname'] %>"
                    }
                ],
            <% else %>
                "id": "<%= @obpsoa['hostnameList'][0] %>",
                "address": "${_.basename}<%= @obpsoa['dns_domain_name'] %>",
                "properties": [
                    {
                        "name": "basename",
                        "value": "<%= @obpsoa['hostnameList'][0] %>"
                    }
                ],
            <% end %>
                "groupRefs":
                [
                    "Common_Host_Details",
                    "List_Of_TVT_Tests"
                ]
            },
            {
                "id": "db_server",
                "address": "<%= @obpobu['database']['scan_address'] %>",
                "groupRefs":
                [
                    "Common_Host_Details"
                ],
                "properties": [
                    {
                        "name": "scaleout",
                        "value": "false"
                    }
                ]
            }
        ],
        "installationList": [
            {
                "name": "jdk",
                "product": "jdk",
                "version": "1.8.0_221",
                "installPath": "<%= java_install_path %>",
                "softwareStage": "${stageRootDir}/jdk/jdk-8u221-linux-x64.tar.gz",
                "groupRefs":
                [
                    "Common_Installation_Details"
                ]
            },
            {
                "name": "fmwinfra",
                "product": "OracleFMWInfrastructure",
                "version": "12.2.1.3",
                "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/fmw_12.2.1.3.0_infrastructure.jar",
                "installPath": "<%= fmw_install_path %>",
                "dependsonList": [
                    "jdk"
                ],
                "attributes": {
                    "newworld": "true",
                    "middlewareHome": "<%= fmw_install_path %>",
                    "oracleInventoryLoc": "<%= inventory_install_path %>",
                    "OracleFMWInfrastructure": {
                        "inventory_location": "<%= inventory_install_path %>",
                        "fmw_home": "<%= fmw_install_path %>",
                        "owner": "oracle",
                        "group": "oinstall"
                    }
                },
                "patchset": [
				    {
						"targetOracleHome": "${_.installPath}",
						"softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
						"name": "29814665",
						"aru": "29814665",
						"properties": [
							{
							  "name": "action",
							  "value": "rollback"
							}
						]
                    },
                    {
                        "targetOracleHome": "${_.installPath}",
                        "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
                        "name": "30386660",
                        "aru": "30386660",
                        "properties": [
                            {
                              "target": "opatch.minimum.version",
                              "value": "13.9.4.2"
                            },
                            {
                              "target": "opatch.binary.location",
                              "value": "${stageRootDir}/common_patches/OPatch/139420/6880880"
                            },
                            {
                              "target": "opatch.update.usegeneric",
                              "value": "true"
                            },
                            {
                              "name": "patchWhen",
                              "value": "post-binaries"
                            }
                        ]
                    },
					{
                        "targetOracleHome": "${_.installPath}",
                        "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
                        "name": "30576401",
                        "aru": "30576401",
                        "properties": [
                            {
                              "target": "opatch.minimum.version",
                              "value": "13.9.4.2"
                            },
                            {
                              "target": "opatch.binary.location",
                              "value": "${stageRootDir}/common_patches/OPatch/139420/6880880"
                            },
                            {
                              "target": "opatch.update.usegeneric",
                              "value": "true"
                            },
                            {
                              "name": "patchWhen",
                              "value": "post-binaries"
                            }
                        ]
                    },
                    {
                        "targetOracleHome": "${_.installPath}",
                        "softwareStage": "${stageRootDir}/fmwinfra/12.2.1.3/patches",
                        "name": "29909359",
                        "aru": "29909359",
                        "properties": [
                            {
                              "target": "opatch.minimum.version",
                              "value": "13.9.4.2"
                            },
                            {
                              "target": "opatch.binary.location",
                              "value": "${stageRootDir}/common_patches/OPatch/139420/6880880"
                            },
                            {
                              "target": "opatch.update.usegeneric",
                              "value": "true"
                            },
                            {
                              "name": "patchWhen",
                              "value": "post-binaries"
                            }
                        ]
                    }
                ]
            },
            {
                "name": "soa",
                "product": "OracleSOASuite",
                "version": "12.2.1.3",
                "installPath": "<%= fmw_install_path %>/soa",
                "softwareStage": "${stageRootDir}/soa/12.2.1.3/fmw_12.2.1.3.0_soa.jar",
                "dependsonList": [
                    "fmwinfra"
                ],
                "attributes": {
                    "newworld": "true",
                    "OracleSOASuite": {
                        "inventory_location": "<%= inventory_install_path %>",
                        "fmw_home": "<%= fmw_install_path %>",
                        "java_home": "<%= java_install_path %>",
                        "owner": "oracle",
                        "group": "oinstall"
                    }
                }
            },
            {
                "name": "obp-ui",
                "product": "OracleBankingPlatform::UIInstallation",
                "version": "2.7.1.0.0",
                "installPath": "<%= fmw_install_path %>/obpinstall",
                "softwareStage": "${stageRootDir}/obp/2.7.1/obp-ui/obpinstall-ui",
                "dependsonList": [
                    "soa"
                ],
                "attributes": {
                    "newworld": "true",
                    "OracleBankingPlatform::UIInstallation": {
                        "inventory_location": "<%= inventory_install_path %>",
                        "java_home": "<%= java_install_path %>",
                        "fmw_home": "<%= fmw_install_path %>"
                    }
                }
            }

        ],
        "environmentList": [
            {
                "name": "<%= environment_name %>",
                "mwTopologyList": [
                    {
                        "name": "<%= asset_code %>",
                        "description": "<%= environment_name %> <%= asset_code %> Environment",
                        "nodeManagerList": [
                            {
                                "name": "nm-<%= @obpobu['hostnameList'][0] %>",
                                "listenAddress": "<%= @obpobu['nm']['listen_address'] %><%= @obpobu['dns_domain_name'] %>",
                                "listenPort": "<%= @obpobu['nm']['listen_port'] %>",
                                "hostIdentifier": "<%= @obpobu['hostnameList'][0] %>",
                                "groupRefs": [
                                    "Node_Manager_Common_Config",
                                    "Node_Manager_SSL_Config"
                                ],
                                "properties": [
                                    {
                                        "target": "wls.nodemanager.log.path",
                                        "value": "<%= log_location_path %>/${/host.basename}"
                                    },
                                    {
                                        "value": "${/host.basename}",
                                        "target": "wls.nodemanager.identityname"
                                    },
                                    {
                                        "value": "<%= certs_location_path %>/<%= @obpobu['hostnameList'][0][0...-2] %>.jks",
                                        "target": "wls.nodemanager.identitystorefile"
                                    }
                                ]
                            }
                        ],
                        "domainList": [
                            {
                                "name": "<%= @obpobu['wls_domain_name'] %>",
                                "locationPath": "<%= obu_admin_server_top %>",
                                "adminUser": "<%= @obpobu['wls_admin_user'] %>",
                                "adminPassword": "<%= PasswordVault.get_password(password_vault_name, asset_code, @obpobu['wls_admin_user'] ) %>",
                                "adminServer": {
                                    "name": "AdminServer",
                                    "machineName": "Machine-<%= @obpobu['hostnameList'][0] %>",
                                    "listenAddress": "<%= @obpobu['admin']['listen_address'] %><%= @obpobu['dns_domain_name'] %>",
                                    "listenAddressPort": "<%= @obpobu['admin']['listen_port'] %>",
                                    "listenAddressPortSSL": "<%= @obpobu['admin']['listen_port_ssl'] %>",
                                    "targetName": "<%= asset_code[3..-1] %>AdminServer"
                                },
                                "attributes": {
                                    "newworld": "true",
                                    "exclude_fmwinfra_template": "true"
                                },
                                "machineList": [
                                    {
                                        "name": "Machine-<%= @obpobu['hostnameList'][0] %>",
                                        "nodeManagerName": "nm-<%= @obpobu['hostnameList'][0] %>"
                                    }
                                ],
                                "clusterList": [
                                  {
                                    "name": "<%= @obpobu['obpui_server']['cluster_name'] %>",
                                    "messageMode": "Unicast"
                                  }
                                ],
                                "managedServerList": [
                                    {
                                        "name": "obpui_server1",
                                        "machineName": "Machine-<%= @obpobu['hostnameList'][0] %>",
                                        "clusterName": "<%= @obpobu['obpui_server']['cluster_name'] %>",
                                        "listenAddress": "<%=  @obpobu['obpui_server']['listen_address'] %><%= @obpobu['dns_domain_name'] %>",
                                        "listenAddressPort": "<%=  @obpobu['obpui_server']['listen_port'] %>",
                                        "listenAddressPortSSL": "<%=  @obpobu['obpui_server']['listen_port_ssl'] %>",
                                        "targetName": "${_.name}"
                                    }
                                ],
                                "middlewareList": [
                                    {
                                        "installationName": "obp-ui",
                                        "targetList": [
                                            {
                                              "type": "Cluster",
                                              "names":
                                              [
                                                "<%= @obpobu['obpui_server']['cluster_name'] %>"
                                              ]
                                            }
                                        ]
                                    }
                                ],
                                "configurationList": [

                                     <%= render "common-settings-configs.erb"  %>
                                    ,
                                    {
                                        "resourceName": "GenericServerSettings_auto_1",
                                        "type": "Server",
                                        "properties": [
                                            {
                                                "name": "serverName",
                                                "value": "obpui_server1"
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "ClusterStartupParameters",
                                        "type": "StartupParameter",
                                        "targets": [
                                            {
                                                "type": "CLUSTER",
                                                "names": [
                                                    "<%= @obpobu['obpui_server']['cluster_name'] %>"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "JpsConfigSettings",
                                        "type": "JpsConfig",
                                        "properties": [
                                          {
                                            "name": "serverInstance",
                                            "value": "idstore.ldap"
                                          }
                                        ]
                                    },
                                    {
                                        "resourceName": "JdbcSharedSettings",
                                        "type": "JDBCSystemResource",
                                        "properties":
                                        [
                                            {
                                                "name": "dataSourceName",
                                                "value": "opss-data-source,opss-audit-DBDS,opss-audit-viewDS"
                                            },
                                            {
                                                "name": "noTarget",
                                                "value": "true"
                                            }
                                        ],
                                        "targets": []
                                    },
                                    {
                                        "resourceName": "OBP_SYS_CONFIG",
                                        "type": "JDBCSystemResource",
                                        "targets": [
                                            {
                                                "type": "CLUSTER",
                                                "names": [
                                                    "<%= @obpobu['obpui_server']['cluster_name'] %>"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "ClusterClassPathParameters",
                                        "type": "ClassPath",
                                        "targets": [
                                            {
                                                "type": "CLUSTER",
                                                "names": [
                                                    "<%= @obpobu['obpui_server']['cluster_name'] %>"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "OAMIdentityAsserter",
                                        "type": "AuthenticationProvider",
                                        "properties": [
                                            {
                                                "name": "realmName",
                                                "value": "myrealm"
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "OIDAuthenticator",
                                        "type": "AuthenticationProvider",
                                        "properties": [
                                            {
                                                "name": "realmName",
                                                "value": "myrealm"
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "DefaultAuthenticator",
                                        "type": "AuthenticationProvider",
                                        "properties": [
                                            {
                                                "name": "realmName",
                                                "value": "myrealm"
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "JMSFileStore_obpui_server1",
                                        "type": "FileStore",
                                        "targets": [
                                          {
                                            "type": "SERVER",
                                            "names": [
                                              "obpui_server1"
                                            ]
                                          }
                                        ]
                                    },
                                    {
                                        "resourceName": "jmsserver_obpui_server1",
                                        "type": "JMSServer",
                                        "properties": [
                                          {
                                            "name": "fileStore",
                                            "value": "JMSFileStore_obpui_server1"
                                          }
                                        ],
                                        "targets": [
                                          {
                                            "type": "SERVER",
                                            "names": [
                                              "obpui_server1"
                                            ]
                                          }
                                        ]
                                    },
                                    {
                                        "resourceName": "jmsAsyncAuditModule",
                                        "type": "JMSSystemResource",
                                        "properties": [
                                            {
                                                "name": "subDeployment",
                                                "value": "jmsAsyncAuditModule_sub"
                                            }
                                        ],
                                        "targets": [
                                            {
                                                "type": "CLUSTER",
                                                "names": [
                                                    "<%= @obpobu['obpui_server']['cluster_name'] %>"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "resourceName": "jmsAsyncAuditModule_sub",
                                        "type": "SubDeployment",
                                        "targets": [
                                            {
                                                "type": "JMSServer",
                                                "names": [
                                                    "jmsserver_obpui_server1"
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "properties": [
                                    {
                                        "name": "serverStartMode",
                                        "value": "prod",
                                        "target": "wls.production.mode"
                                    },
                                    {
                                        "name": "backupEnvironmentName",
                                        "value": "<%= environment_name %>",
                                        "target": "environment.name"
                                    },
                                    {
                                        "name": "tlogsLocationPath",
                                        "value": "<%= base_domain_path %>/${/domain.name}",
                                        "target": "wls.tlogs.location.path"
                                    },
                                    {
                                        "name": "odlLogLocation",
                                        "value": "<%= log_location_path %>/${/domain.name}",
                                        "target": "wls.odl.log.location"
                                    },
                                    {
                                        "value": "<%= @common['odl_log_retentionPeriod'] %>",
                                        "target": "wls.odl.log.retentionPeriod"
                                    },
                                    {
                                        "name": "defaultJMSLogLocation",
                                        "value": "<%= log_location_path %>/${/domain.name}"
                                    },
                                    {
                                        "target": "wls.admin.listen.port.admin",
                                        "value": "<%= @obpobu['admin']['listen_port_admin'] %>"
                                    },
                                    {
                                        "name": "mintpress.startup_parallel",
                                        "target": "mintpress.startup_parallel",
                                        "value": "10"
                                    }
                                ],
                                "templateList": [
                                    {
                                        "name": "OracleBankingPlatform::UITemplateSet",
                                        "attributes": {
                                            "OracleBankingPlatform::UITemplateSet": {
                                                <% if @obpobu['alter_site_reassociate_hostname'] %>
                                                "soa_transport": "transport[<%= @obpobu['alter_site_reassociate_hostname'] %>]",
                                                <% else %>
                                                "soa_transport": "transport[<%= @obpsoa['hostnameList'][0] %><%= @obpsoa['dns_domain_name'] %>]",
                                                <% end %>
                                                "soa_fmw_home": "/oracle/app/binaries/obpsoa/fmw",
                                                "soa_domain_home": "/oracle/app/runtime/obpsoa/domains/obpsoa_domain",
                                                "soa_opss_schema_name": "<%= @obpsoa['database']['rcu_schema_prefix'] %>_opss",
                                                "soa_opss_schema_password": "<%= PasswordVault.get_password(password_vault_name, 'obpsoa', @obpsoa['database']['rcu_schema_prefix'].upcase ) %>",
                                                "soa_opss_database_url": "<%= @obpsoa['database']['soa_db_url'] %>",
                                                "soa_jndi_url": "<%= "t3s://#{@obpsoa['frontend']['otd_vip_name']}:#{@obpsoa['frontend']['t3_port']}/soa-infra" %>",
                                                "soa_process_url": "<%= "https://#{@obpsoa['frontend']['otd_vip_name']}:#{@obpsoa['frontend']['soa_port']}" %>",
                                                "ra_offline_channel_username": "offlineuser",
                                                "ra_offline_channel_password": "<%= PasswordVault.get_password(password_vault_name, 'obpoid', 'offlineuser' ) %>",
                                                "ra_ipm_username": "<%= @obpipm['ipm_admin_user'] %>",
                                                "ra_ipm_password": "<%= PasswordVault.get_password(password_vault_name, 'obpoid', @obpipm['ipm_admin_user'] ) %>"

                                            }
                                        }
                                    }
                                ],
                                "repositoryList": [
                                    {
                                        "componentList": [
                                            "OPSS",
                                            "STB",
                                            "WLS",
                                            "MDS"
                                        ],
                                        "id": "rcu01",
                                        "dbName": "<%= environment_name %><%= asset_code %>db",
                                        "prefix": "<%= @obpobu['database']['rcu_schema_prefix'].upcase %>",
                                        "dbUser": "<%= @obpobu['database']['sysdba_username'].upcase %>",
                                        "schemaPassword": "<%= PasswordVault.get_password(password_vault_name, asset_code, @obpobu['database']['rcu_schema_prefix'].upcase ) %>",
                                        "defaultRepository": "true"
                                    }
                                ]
                            }
                        ],
                        "properties": [
                            {
                                "name": "targetPlatform",
                                "value": "EXA"
                            }
                        ],
                        "hostInstallationList": [
                            {
                                "installationName": "obp-ui",
                                "hostIdentifierList": [
                                    "<%= @obpobu['hostnameList'][0] %>"
                                ]
                            }
                        ],
                        "transferList": [

                            <%= render "common-certs-transfer.erb",
                                :variables => {
                                    :host_identifier => @obpobu['hostnameList'][0],
                                    :environment_name => environment_name,
                                    :asset_code => asset_code,
                                    :keystore_name => @obpobu['hostnameList'][0][0...-2],
                                    :certs_source_path => @common['certs_source'],
                                    :cert_destination_path => certs_location_path,
                                    :truststore => @common['trustStore']
                                }
                            %>
                            ,
                            <%= render "common-jdk-policy-transfer.erb",
                                :variables => {
                                    :host_identifier => @obpobu['hostnameList'][0],
                                    :environment_name => environment_name,
                                    :asset_code => asset_code,
                                    :jdk_version => jdk_version,
                                    :java_install_path => java_install_path
                                }
                            %>
                            ,
                            <%= render "common-transfer-ovd-keystore.erb",
                                :variables => {
                                    :environment_name => environment_name,
                                    :host_identifier => @obpobu['hostnameList'][0],
                                    :certs_source_path => @common['certs_source'] ,
                                    :admin_server_top => obu_admin_server_top,
                                    :domain_name => @obpobu['wls_domain_name']
                                }
                            %>
                            ,
                            {
                                "name": "SIEMCustomAuditor",
                                "hostIdentifierList": [
                                  "<%= @obpobu['hostnameList'][0] %>"
                                ],
                                "sourceFile": "<%= @common['custom_source'] %>/common/SIEMCustomAuditor.jar",
                                "destinationFile": "<%= fmw_install_path %>/wlserver/server/lib/mbeantypes/SIEMCustomAuditor.jar",
                                "permissions": "600",
                                "transferWhenList": [
                                  "post-binaries",
                                  "pre-online"
                                ],
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "true"
                                    }
                                ]
                            },
                            {
                                "name": "HealthCheckFileCopy",
                                "hostIdentifierList": [
                                  "<%= @obpobu['hostnameList'][0] %>"
                                ],
                                "sourceFile": "<%= "#{@common['custom_source']}/common/HealthCheck.war" %>",
                                "destinationFile": "<%= "#{base_domain_path}/applications/#{@obpobu['wls_domain_name']}/HealthCheck.war" %>",
                                "permissions": "755",
                                "transferWhenList": [
                                  "pre-online"
                                ],
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ]
                            }
                        ],
                        "executeList": [
                            {
                                "name": "UpdateAdaptersOSXml",
                                "hostIdentifierList": [
                                    "<%= @obpobu['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::update-wls-ldap-adapters]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-online"
                                ]
                            },
                            {
                                "name": "UpdateJpsConfigParams",
                                "hostIdentifierList": [
                                    "<%= @obpobu['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::update-jps-config]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "pre-online"
                                ]
                            },
                            {
