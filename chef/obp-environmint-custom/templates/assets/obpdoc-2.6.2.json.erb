                        "target": "documaker.ums.username",
                        "value": "<%= @obpdoc['documaker']['ums_user'] %>"
                    },
                    {
                        "target": "documaker.ums.password",
                        "value": "<%= PasswordVault.get_password(password_vault_name, asset_code, @obpdoc['documaker']['ums_user']) %>"
                    },
                    {
                        "target": "documaker.ums.endpoint",
                        "value": "endpointURLGoesHere"
                    },
                    {
                        "target": "documaker.appdeploy.stage",
                        "value": "<%= fmw_install_path %>/odee_12"
                    },
                    {
                        "target": "documaker.dmkr.appdeploy.enabled",
                        "value": "true"
                    },
                    {
                        "target": "documaker.dmkr.appdeploy.target.name",
                        "value": "<%= @obpdoc['dmkr_server']['cluster_name'] %>"
                    },
                    {
                        "target": "documaker.idm.appdeploy.enabled",
                        "value": "true"
                    },
                    {
                        "target": "documaker.idm.appdeploy.target.name",
                        "value": "<%= @obpdoc['idm_server']['cluster_name'] %>"
                    },
                    {
                        "target": "documaker.soa.appdeploy.enabled",
                        "value": "true"
                    },
                    {
                        "target": "documaker.soa.partition.name",
                        "value": "default"
                    },
                    {
                        "target": "documaker.obp.integration.enabled",
                        "value": "false"
                    },
                    <% if environment_name =~ /^svp\d*w/ or environment_name =~ /^prd\d*w/ %>
                    {
                        "name": "seedDocumakerSchemaObjects",
                        "value": "false"
                    }
                    <% else %>
                    {
                        "name": "seedDocumakerSchemaObjects",
                        "value": "true"
                    }
                    <% end %>
                ]
            }
        ]
    }
}
