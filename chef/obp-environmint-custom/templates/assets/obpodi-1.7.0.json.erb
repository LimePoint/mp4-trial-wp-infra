                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
                                ],
                                "executeWhenList": [
                                    "post-rcu"
                                ]
                            },
                            {
                                "name": "DeleteDatabaseObjects",
                                "hostIdentifierList": [
                                    "<%= @obpodi['hostnameList'][0] %>"
                                ],
                                "sourceFile": "chef-client -c $HOME/chef/client.rb -o 'recipe[obp-environmint-custom::drop-db-users]' -l info",
                                "properties": [
                                    {
                                        "name": "scaleout",
                                        "value": "false"
                                    }
