                    "4": "<%= "-javaagent:#{@common['appdynamics_agent']} -Dappagent.install.dir=/oracle/app/binaries/appdynamics/javaagent -Dappdynamics.agent.tierName=OBP-OSB -Dappdynamics.agent.nodeName=%ListenAddress/noprefix%#{@obposb['dns_domain_name']}:%ListenPort+1000%" if @common['enable_appdynamics'] == "true" %>",
					"5": "<%= "-javaagent:/oracle/app/binaries/contrast_agent/contrast.jar" if @common['enable_contrastagent'] == "true" %>",
                    "6": "-Doracle.osb.json.nillable.support=false",
                    "7": "-Dfile.encoding=UTF-8",
