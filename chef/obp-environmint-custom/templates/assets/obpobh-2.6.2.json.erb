                "value": "<%= PasswordVault.get_password(password_vault_name, 'obpoid', @obpobu['wls_admin_user'] ) %>"
                },
                {
                "target": "obp.bamUsername",
                "value": "<%= @obpsoa['soa_admin_user'] %>"
                },
                {
                "target": "obp.bamPassword",
                "value": "<%= PasswordVault.get_password(password_vault_name, 'obpoid', @obpsoa['soa_admin_user'] ) %>"
                },
                {
                    "target": "obp.ui.mdsusername",
                    "value": "<%= "#{@obpobu['database']['rcu_schema_prefix']}_MDS" %>"
                },
                {
                    "target": "obp.ui.mdspassword",
                    "value": "<%= PasswordVault.get_password(password_vault_name, 'obpobu', @obpobu['database']['rcu_schema_prefix'].upcase) %>"
                },
                {
                    "target": "obp.ui.mdsJDBCUrl",
                    "value": "<%= @obpobu['database']['ui_db_url']%>"
                },
                {
                "name": "deployLocalization",
                "value": "true"
                },
                {
                "target": "obp.localization.country",
                "value": "au"
                }
            ]
            },
            {
            "name": "OBPHOST_PolicySeed",
            "description": "OBP Database Policy Seed",
            "properties": [
                {
                "name": "seedOIDPolicies",
                "value": "false"
                },
                {
                "target": "obp.soa.ssh.hostname",
                <% if @obpobh['alter_site_reassociate_hostname'] %> 
                    "value": "<%= @obpobh['alter_site_reassociate_hostname'] %>"
                <% else %>
                    "value": "<%= @obpsoa['hostnameList'][0] %><%= @obpsoa['dns_domain_name'] %>"
                    <% end %>
                },
                {
                "target": "obp.soa.fmw.home",
                "value": "/oracle/app/binaries/obpsoa/fmw"
                },
                {
                "target": "obp.soa.java.home",
                "value": "/oracle/app/binaries/obpsoa/java"
                },
                {
                "target": "obp.soa.jps.domain.name",
                "value": "<%= @obpsoa['wls_domain_name'] %>"
                },
                {
                "target": "obp.soa.jps.root",
                "value": "cn=opssRoot"
                },
                {
                "target": "obp.host.software.stage",
                "value": "${stageRootDir}/obp/2.6.2/obp-host"
                }
               ]
            },
            {
            "name": "OBPHOST_DatabaseSeed",
            "description": "OBP DB Policy Seed",
            "properties": [
                {
                "name": "seedOBPSchemaObjects",
                    <% if environment_name =~ /^svp\d*w/ or environment_name =~ /^prd\d*w/ or is_running_on_cloud %>
                        "value": "false"
                    <% else %>
                        "value": "true"
                    <% end %>
                },
                {
                "name": "updateIntegrationEndPoints",
                "value": "false"
                },
                {
                "target": "obp.oracle.client.home",
                "value": "<%= oracle_install_path %>"
                }
            ]
            },
            {
            "name": "OBPHOST_BIPReports",
            "description": "Properties to upload BIP reports",
            "properties": [
                {
                "name": "uploadBIPReports",
                "value": "false"
                }
            ]
            },
            {
            "name": "Policy_Store_Reassociation_Configuration",
            "description": "Commong JPS configuration to reassociated",
            "properties": [
                {
                "name": "reassociateSecurityStoreDB",
                "value": "true"
                },
                {
                "name": "jpsdomainname",
                "value": "opssSecurityStore",
                "target": "jps.domain.name"
                },
                {
                "value": "cn=opssRoot",
                "target": "db.jpsroot"
                },
                {
                "name": "joindomain",
                "value": "true",
                "target": "join.domain"
                },
                {
                "value": "/oracle/app/binaries/obpsoa/fmw",
                "target": "jps.source.fmw.home"
                },
                {
                "value": "/oracle/app/runtime/obpsoa/domains/obpsoa_domain",
                "target": "jps.source.domain.dir"
                },
                {
                "target": "jps.source.ssh.hostname",
                <% if @obpobh['alter_site_reassociate_hostname'] %> 
                    "value": "<%= @obpobh['alter_site_reassociate_hostname'] %>"
                <% else %>
                    "value": "<%= @obpsoa['hostnameList'][0] %><%= @obpsoa['dns_domain_name'] %>"
                    <% end %>
                },
                {
                "value": "true",
                "target": "jps.force.reassociate"
                },
                {
                "value": "<%= @obpsoa['database']['rcu_schema_prefix'] %>_opss",
                "target": "jps.db.username"
                },
                {
                "value": "<%= PasswordVault.get_password(password_vault_name, 'obpsoa', @obpsoa['database']['rcu_schema_prefix'].upcase ) %>",
                "target": "jps.db.userpassword"
                },
                {
                "value": "<%= @obpsoa['database']['soa_db_url'] %>",
                "target": "jps.db.url"
                }
             ]
        }
        ]
    }
}
