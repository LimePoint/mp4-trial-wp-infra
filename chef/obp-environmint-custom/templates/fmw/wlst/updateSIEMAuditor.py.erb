#Below function used to connect to WLST prompt

def dkinit(user=username, passwd=password, url=url):
        try:
                connect(user,passwd,url)
        except StandardError, se:
                        print "---->Error occured while connecting to url",url
                        print "\n", se
                        exit()
        except Exception ,e:
                        print "---->Exception raised while connecting to url",url
                        print "\n", e
                        exit()

