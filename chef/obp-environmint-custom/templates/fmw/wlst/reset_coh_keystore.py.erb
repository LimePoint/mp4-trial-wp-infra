# This script resets the coherence keystore password to facilitate recreation of the keystore using a stronger key.
# See Oracle (Doc ID 1986560.1)

# arg1 - weblogic username
# arg2 - weblogic password
# arg3 - weblogic admin url
# arg4 - JPS map name
# arg5 - JPS key name
# arg6 - Credential name
# arg7 - Credential description
# arg8 - Credential password

wls_username=sys.argv[1]
wls_password=sys.argv[2]
t3_connect_url=sys.argv[3]
mapName='OAM_STORE'
keyName='coh'
credName='coh'
credDesc='cohstore_pwd'
credPass=sys.argv[4]

import os;
import sys;
import time;

connect(wls_username,wls_password,t3_connect_url)

domainRuntime()
jpsCredentialStore = ObjectName("com.oracle.jps:type=JpsCredentialStore")

# create normal password credential
# pc = createCredObj("name", "password", "description")
pc = createCredObj(credName, credPass, credDesc)
cd = pc.toCompositeData(None)
params = [mapName, keyName, cd]
sign = ["java.lang.String", "java.lang.String", "javax.management.openmbean.CompositeData"]
mbs.invoke(jpsCredentialStore, "resetPortableCredential", params, sign)

disconnect()

def createCredObj(user, password, desc) :
    from oracle.security.jps.mas.mgmt.jmx.credstore import PortablePasswordCredential
    #Create Password Credential object
    pc = PortablePasswordCredential(user, password, desc)
    return pc