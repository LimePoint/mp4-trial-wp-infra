<% #Building mailing list for notifications
    env_name = @environment
    recipients = 'cshwp@limepoint.com'
    bpad_devops = ['DL.BPAD.DevOps@westpac.com.au']
    bpad_devops_env = (1..31).to_a.map{|e| "bpd"+e.to_s}
    if bpad_devops_env.include?(env_name)
        recipients +=", #{bpad_devops.join(', ')}"
    end
%>
<%
  dep_primary_node = @obpipm
  odi_encoded_obpobh_db_pwd = @odi_encoded_obpobh_db_pwd ; if odi_encoded_obpobh_db_pwd.nil? then odi_encoded_obpobh_db_pwd='TBD' end
  odi_encoded_obpobh_wls_pwd = @odi_encoded_obpobh_wls_pwd ; if odi_encoded_obpobh_wls_pwd.nil? then odi_encoded_obpobh_wls_pwd='TBD' end
  puts env_name
  puts dep_primary_node
  puts odi_encoded_obpobh_db_pwd
  puts odi_encoded_obpobh_wls_pwd
  puts "Notifications will be sent to "+recipients
%>
