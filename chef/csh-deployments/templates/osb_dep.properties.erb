<%
    env_name = @environment
    DOMAIN_NAME = @topology_vars['obposb']['dns_domain_name']
    OSB_JMS_SRV =  @topology_vars['obposb']['osb_server']['listen_address']+DOMAIN_NAME+":"+@topology_vars['obposb']['osb_server']['listen_port']
    OBH_JMS_SRV =  @topology_vars['obpobh']['obphost_server']['listen_address']+DOMAIN_NAME+":"+@topology_vars['obpobh']['obphost_server']['listen_port']
    OSB_FRONTEND = @topology_vars['obposb']['frontend']['managed_host']+":"+@topology_vars['obposb']['frontend']['osb_port']
    OBH_FRONTEND = @topology_vars['obpobh']['frontend']['managed_host']+":"+@topology_vars['obpobh']['frontend']['obh_port']
    IPM_FRONTEND = @topology_vars['obpipm']['frontend']['managed_host']+":"+@topology_vars['obpipm']['frontend']['ipm_port']

    lisa_socket = @topology_vars['common']['lisa_socket']

  #LIST OF SA passwords
    SA_DLM_API_OSB_PWD = PasswordVault.get_password(@topology_vars['common']['password_vault_name'], 'obpoid', 'SA_DLM_API_OSB_USER')
    SA_OBP_IPM_MANAGE_PWD = PasswordVault.get_password(@topology_vars['common']['password_vault_name'], 'obpoid', 'SA_OBP_IPM_MANAGE_USER')
    SA_VALEX_API_OSB_PWD = PasswordVault.get_password(@topology_vars['common']['password_vault_name'], 'obpoid', 'SA_VALEX_API_OSB_USER')
    SA_SAM_PARTY_ONBOARD_PWD = PasswordVault.get_password(@topology_vars['common']['password_vault_name'], 'obpoid', 'SA_SAM_PARTY_ONBOARD_USER')
    SA_OCH_OBP_MANAGE_PWD = PasswordVault.get_password(@topology_vars['common']['password_vault_name'], 'obpoid', 'SA_OCH_OBP_MANAGE_USER')

  #FOR Environments integrated with OCH
  och1_envs = [4,8,12].map{|s| "bpd"+s.to_s}
  och2_envs = [7,13,21,26,29].map{|s| "bpd"+s.to_s}
  och3_envs = []
  r18_envs = [1,2,3,5,7,9,10,16,20,21,22,23,24].map{|s| "bpd"+s.to_s}

  case
    when och1_envs.include?(env_name)
      och_socket = 'obpcoch01.wpdev.mintpress.io'
    when och2_envs.include?(env_name)
      och_socket = 'obpcoch21.wpdev.mintpress.io'
    when och3_envs.include?(env_name)
      och_socket = 'obpcoch31.wpdev.mintpress.io'
    else
      och_socket = lisa_socket
  end
%>
