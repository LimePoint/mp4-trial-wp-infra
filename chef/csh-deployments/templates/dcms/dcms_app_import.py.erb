#Script for DCMS IPM App Creation
#Author: Harsha Gurram

import sys

connect(sys.argv[1],sys.argv[2],'t3://'+sys.argv[3]+':17102')
ipmAppArray=['DCMSDocuments']
for ipmApp in ipmAppArray :
    try :
        importIPMApplication(exportFile="<%= @app_definition_xml %>", action="<%= @action %>", name=ipmApp, repository="UCM Connection", securityOption="ValidOnly", docSecurityOption="ValidOnly", storageOption="Volume", storageVolume="CSHIPMDB")
        print 'Successfully imported Application ' +ipmApp
    except :
        dumpStack()
        print 'Failed import of ' +ipmApp
        sys.exit(1)
disconnect()
exit()
