    {
      "name": "weblogicHome",
      "value": "/oracle/app/binaries/obpurm/fmw/wlserver_10.3"
    },
    {
      "name": "frontendurl",
      "value": "https://<%=@obpurm['frontend']['otd_vip_name']%>:<%=@obpurm['frontend']['urm_port']%>/urm/idcplg"
    }

