      "properties": [
        {
          "name": "targets",
          "value": "DefaultServer"
        },
        {
          "name": "port",
          "value": "17001"
        },
        {
          "name": "protocol",
          "value": "t3"
        },
        {
          "name": "descriptiveName",
          "value": "Admin Server"
        }]
