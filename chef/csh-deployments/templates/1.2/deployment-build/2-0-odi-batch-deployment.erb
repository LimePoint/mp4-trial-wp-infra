    "OBPSCRIPTSVERSION" : "<%= @manifest_vars['deployments']['odi_batch']['extension_version']%>",
    "OBP_DEPLOY_HOME" : "<%= @dataBag['deployment']['MINT_DEPLOY_HOME']%>/obpProductDeploy/odiExpress",
    "OBP_HOST_NODE" : "<%= @dataBag['obpobh']['hostnameList'][0]%><%= @dataBag['obpobh']['dns_domain_name']%>",
    "OBP_NODE_1" : "<%= @dataBag['obpodi']['hostnameList'][0]%><%= @dataBag['obpodi']['dns_domain_name']%>",
    "OBP_STARTSCRIPT_HOME" : "<%= @dataBag['deployment']['MINT_DEPLOY_HOME']%>/obpProductDeploy/obpStartupShutdown",
    "cemliArtifactoryURL" : "<%= @dataBag['deployment']['CEMLI_ARTIFACTORY_URL']%>",
    "debug" : "false"
  },
