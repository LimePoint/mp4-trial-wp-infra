<%

    MANIFEST_PCSM_VERSION=node.default['pcsm_version']



    puts "PCSM Version #{MANIFEST_PCSM_VERSION}"
    #puts "Here is  the dump of all node defaults"
    #puts node.default
    #PLAN_NAME = @environment_name+"_DEPLOYMENTS_"+uniquifier.upcase
    #TRIMMED_PLAN_NAME = PLAN_NAME.gsub("_","").upcase
    csh_release_version = @dataBag['deployment']['CSH_RELEASE_VERSION']
    puts "Pickup Template for CSH Release Path========>>  #{csh_release_version}"


    MANIFEST_BUILD=@environment_name+"_"+node.default['build_version']
    plan_name=MANIFEST_BUILD.gsub("-","_").upcase

    puts "Manifest Plan Name ========>>  #{plan_name}"
    prev_proj_name=node.run_state['prev_proj_name']
    puts "Previous Proj  Name ========>>  #{prev_proj_name}"
    version_index =  prev_proj_name.index(plan_name+"_V_")
    puts version_index
    if version_index.nil?
      puts "Version Index Not Found in the previous build project key, so assigning default to 1"
      cur_version = 1
    else
      prev_version =  prev_proj_name[prev_proj_name.index("_V_")+3, prev_proj_name.length]
      puts "Prev Version found from the git build json #{prev_version}"

      prev_version = prev_version.to_i+1
      cur_version = prev_version
    end


    puts "Calculated current version of the project #{cur_version}"
    new_plan_name=plan_name+"_V_#{cur_version}"
    attempt = 0
    while(attempt < 10 ) do
        attempt += 1
        puts "Trying new plan name #{new_plan_name}  Retry : #{attempt}"
        if isPlanExists(new_plan_name, @dataBag )
          puts "plan exists already, lets bump the version"
          cur_version = cur_version + 1
          new_plan_name=plan_name+"_V_#{cur_version}"
        else
          puts "This plan does not exists on the runtime, use the plan"
          break
        end
        sleep(1)
    end
    TRIMMED_PLAN_NAME = new_plan_name.gsub("_","").upcase
    puts "Manifest Plan Name Adjusted========>>  #{new_plan_name}"
    puts "Manifest Trimmed Plan Name Adjusted========>>  #{TRIMMED_PLAN_NAME}"
