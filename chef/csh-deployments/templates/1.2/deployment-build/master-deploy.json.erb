<%
  HOST_DB_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpobh', 'OBPHOST' ))
  SA_CONFIGUPLOADER_OBP_USER_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpoid', 'SA_CONFIGUPLOADER_OBP_USER'))
  IPM_ADMIN_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpoid', 'obpipm_admin' ))
  SA_DOCUMAKER_OBP_MANAGE_USER_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpoid', 'SA_DOCUMAKER_OBP_MANAGE_USER' ))
  OBPSOA_OPSS_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpsoa', 'OBPSOA' ))
  ANALYTICS_SCHEMA_PWD = Mint::AesEncryption.decrypt(PasswordVault.get_password(@dataBag['common']['password_vault_name'], 'obpbip', 'OBPBIP' ))

