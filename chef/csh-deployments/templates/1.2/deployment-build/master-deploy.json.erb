  hostODISSL=""
  portODISSL=""
  @dataBag['obpotd']['otd_config']['obpodi']['origin_pool_list'].each do |list|

    protocolType = list['type']

     if protocolType == 'ssl'
        hostODISSL= list['members'][0]['host']
        portODISSL= list['members'][0]['port']
     end

  end

  #Get the first OAM Host
  mintDeployHosts = ""
  mintDeployHosts << @dataBag['obpoam']['hostnameList'][0]+ @dataBag['obpoam']['dns_domain_name']

  #Get all OBH Hosts
  @dataBag['obpobh']['hostnameList'].each do |host|
    mintDeployHosts << " " + host + @dataBag['obpobh']['dns_domain_name']
  end

  #Get all OBPUI Hosts
  @dataBag['obpobu']['hostnameList'].each do |host|
    mintDeployHosts << " " + host +  @dataBag['obpobu']['dns_domain_name']
  end

  if (@dataBag['deployment']['SECONDARY_SITE'] == "false")
    #Get all SOA BAM, HT servers if baseHostnameList if present
    if (@dataBag['obpsoa']['soa_server']['baseHostnameList'] != nil)
      @dataBag['obpsoa']['soa_server']['hostnameList'].each do |host|
        mintDeployHosts << " " + host +  @dataBag['obpsoa']['dns_domain_name']
      end
    else
      #Get all OBPSOA Hosts
      @dataBag['obpsoa']['hostnameList'].each do |host|
       mintDeployHosts << " " + host  + @dataBag['obpsoa']['dns_domain_name']
      end
    end
  end

  if (@dataBag['deployment']['SECONDARY_SITE'] == "false")
    if (@dataBag['obpsoa']['obphumantask_server']['baseHostnameList'] != nil)
      @dataBag['obpsoa']['obphumantask_server']['hostnameList'].each do |host|
          mintDeployHosts << " " + host +  @dataBag['obpsoa']['dns_domain_name']
      end
    end
  end

  if (@dataBag['deployment']['SECONDARY_SITE'] == "false")
    if (@dataBag['obpsoa']['bam_server']['baseHostnameList'] != nil)
      @dataBag['obpsoa']['bam_server']['hostnameList'].each do |host|
        mintDeployHosts << " " + host +  @dataBag['obpsoa']['dns_domain_name']
      end
    end
  end

  #Get all OBPSOA Hosts
  @dataBag['obpbip']['hostnameList'].each do |host|
    mintDeployHosts << " " + host + @dataBag['obpbip']['dns_domain_name']
  end
  #Get all OBPDOC Hosts
  @dataBag['obpdoc']['hostnameList'].each do |host|
    mintDeployHosts << " " + host  + @dataBag['obpdoc']['dns_domain_name']
  end
  #Get all ODI Hosts
  if (@dataBag['deployment']['SECONDARY_SITE'] == "false")
    @dataBag['obpodi']['hostnameList'].each do |host|
      mintDeployHosts << " " + host +  + @dataBag['obpodi']['dns_domain_name']
    end
  end

  #Get all OSB Hosts
  @dataBag['obposb']['hostnameList'].each do |host|
    mintDeployHosts << " " + host + @dataBag['obposb']['dns_domain_name']
  end

  #Get all URM Hosts
  if (!is_running_on_cloudFn && @dataBag['deployment']['SECONDARY_SITE'] == "false")
    @dataBag['obpurm']['hostnameList'].each do |host|
      mintDeployHosts << " " + host + @dataBag['obpurm']['dns_domain_name']
    end
  end
  puts "List of all hosts ===> #{mintDeployHosts}"


  #TBD fix the names of attributes in the manifest
  asset_array=node.run_state['asset_array']
  manifest_vars=node.run_state['manifest']
  puts "Fetching the Dependencies for Start / Stop / Restart"

  startup_dependency_array = Array.new
  shutdown_dependency_array = Array.new
  restart_dependency_array = Array.new

asset_array.each do | comp|
    puts "Component --------------------------------------------- #{comp}"

    c3= manifest_vars['deployments'][comp]['depends']['startup_tasks']
    puts "START UP TASK :  #{c3}"

    startup_dependency_array = startup_dependency_array |  manifest_vars['deployments'][comp]['depends']['startup_tasks'].split(",").map(&:strip)
    shutdown_dependency_array = shutdown_dependency_array |   manifest_vars['deployments'][comp]['depends']['shutdown_tasks'].split(",").map(&:strip)
    restart_dependency_array = restart_dependency_array |  manifest_vars['deployments'][comp]['depends']['restart_tasks'].split(",").map(&:strip)

    puts "Start Up dependency Array #{startup_dependency_array}"
    puts "Shut Down dependency Array #{shutdown_dependency_array}"
    puts "Restart  dependencyArray #{restart_dependency_array}"

  end

  puts "Start Up dependency Array #{startup_dependency_array}"
  puts "Shut Down dependency Array #{shutdown_dependency_array}"
  puts "Restart  dependencyArray #{restart_dependency_array}"

