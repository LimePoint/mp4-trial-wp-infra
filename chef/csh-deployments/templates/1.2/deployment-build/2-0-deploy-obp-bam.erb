{
  "name": "Step 2 -- Deploy BAM",
  "params": {},
  "stages": [
    {
      "name": "Default Stage",
      "params": {},
      "manual": false,
      "jobs": [
        {
          "name": "Deploy Node 1",
          "description": "",
          "params": {},
          "tasks": [
            {
              "description": "Start BAM",
              "params": {
                "argument": "",
                "scriptLocation": "INLINE",
                "environmentVariables": "",
                "scriptBody": "<%= @script_init_string %>\nssh <%= @ssh_key_string %> -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no ${bamboo.OBP_NODE_1} \"sudo -u oracle -- sh -c '<%= @shell_init_string %>cd ${bamboo.OBP_STARTSCRIPT_HOME}; ${bamboo.GRADLE_HOME}/bin/gradle -PmintDeployHome=../../../mintdeploy -PfetchTargets=true -PenvName=LOCAL -PconfigProviderPath=${bamboo.CONFIGPROVIDERPATH} -PscriptToRun=start-obpbam.py deploy clean -s'\"",
                "interpreter": "RUN_AS_EXECUTABLE",
                "script": "",
                "workingSubDirectory": ""
              },
              "pluginKey": "com.atlassian.bamboo.plugins.scripttask:task.builder.script",
              "finalising": false,
              "enabled": true
            },
            {
              "description": "Download BAM artifact and Deploy",
              "params": {
                "argument": "",
                "scriptLocation": "INLINE",
                "environmentVariables": "",
                "scriptBody" : "<%= @script_init_string %>\nssh <%= @ssh_key_string %> -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no ${bamboo.OBP_NODE_1} \"sudo -u oracle -- sh -c '<%= @shell_init_string %>cd ${bamboo.OBP_DEPLOY_HOME}; chmod 755 scripts/*; rm -rf ../../bam_cache; ${bamboo.GRADLE_HOME}/bin/gradle -b obpBAMDownload.gradle -g ../../bam_cache -PbamVersion=${bamboo.CEMLI_BAM_VERSION} -PuseDeployConfig=true -PartifactoryURL=${bamboo.cemliArtifactoryURL} -PreleasePath=${bamboo.CEMLI_RELEASE_PATH}  deploy clean -s'\"",
                "interpreter": "LEGACY_SH_BAT",
                "script": "",
                "workingSubDirectory": ""
              },
              "pluginKey": "com.atlassian.bamboo.plugins.scripttask:task.builder.script",
              "finalising": false,
              "enabled": true
            }
          ]
        }
      ]
    }
  ],
  "vars": {
    "CEMLI_RELEASE_PATH": "<%= @manifest_vars['deployments']['bam']['cemli_release_path']%>",
    "CEMLI_BAM_VERSION": "<%= @manifest_vars['deployments']['bam']['extension_version']%>",
    "GRADLE_HOME": "/oracle/app/binaries/deployments/gradle",
    "OBP_DEPLOY_HOME": "<%= @dataBag['deployment']['MINT_DEPLOY_HOME']%>/obpProductDeploy/obpBAMDeploy",
    <% if (@dataBag['obpsoa']['bam_server']['hostnameList'] != nil) && (@dataBag['obpsoa']['bam_server']['hostnameList'][0] != nil) then %>   "OBP_NODE_1" : "<%= @dataBag['obpsoa']['bam_server']['hostnameList'][0]%><%= @dataBag['obpsoa']['dns_domain_name']%>", <% else %> "OBP_NODE_1": "<%= @dataBag['obpsoa']['hostnameList'][0]%><%= @dataBag['obpsoa']['dns_domain_name']%>", <% end %>
    "OBP_STARTSCRIPT_HOME": "<%= @dataBag['deployment']['MINT_DEPLOY_HOME']%>/obpProductDeploy/obpStartupShutdown",
    "cemliArtifactoryURL": "<%= @dataBag['deployment']['CEMLI_ARTIFACTORY_URL']%>",
    "CONFIGPROVIDERPATH" : "../../deploymentProperties/<%= @environment_name %>/obpbam.json",
    "debug": "false"
  }
}